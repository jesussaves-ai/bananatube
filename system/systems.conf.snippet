# BananaTube in the menu: add this to /etc/banana/systems.conf, then restart the menu. The package installs the
# app folder and the launcher; this and the theme line in systems.cfg.snippet are the only changes outside it.
#
# Careful: if the card has /data/banana/systems.conf, the menu reads that *instead* of /etc/banana/systems.conf
# (banana-ui-session exports BANANA_SYSTEMS), so the section has to go in the card's file in that case.
#
#   name    the tile's name
#   folder  the app folder the package installed
#   ext     the marker file the menu lists ("BananaTube.app")
#   run     the launcher, with the entry the menu found (%ROM%)
#   perf    the clock profile while it runs: the menu's own is not enough for a video
[bananatube]
name = YouTube
maker = Banana
folder = /usr/share/banana/apps/bananatube
ext = app
run = /usr/libexec/banana/run-bananatube %ROM%
perf = balanced
