# BananaTube in the menu: add this to /etc/banana/systems.conf (or /data/banana/systems.conf on the card), then
# restart the menu. The package installs the app folder and the launcher; this is the only change outside it.
#
#   name    the tile's name
#   folder  the app folder the package installed
#   ext     the marker file the menu lists ("BananaTube.app")
#   run     the launcher, with the entry the menu found (%ROM%)
#   perf    the clock profile while it runs: the menu's own is not enough for a video
[bananatube]
name = YouTube
maker = Banana
folder = /usr/share/banana/apps/bananatube
ext = app
run = /usr/libexec/banana/run-bananatube %ROM%
perf = balanced
